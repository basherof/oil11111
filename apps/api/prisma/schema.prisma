// Rihlati Smart Core — PostgreSQL persistence (doc 05 data model, core subset for Milestone 1).
// v0.1 pragmatics: flexible payloads as Json, states/enums as String (validated by the engine,
// which is the single writer). DB-level enum hardening lands with the Phase-1e migration set.
// Model names match engine store collections (see apps/api/src/engine/store.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime @default(now())
  @@map("users")
}

model Bookings {
  id               String   @id @default(uuid())
  reference        String   @unique
  paymentReference String?  @unique
  customerName     String
  customerPhone    String
  serviceType      String
  state            String   // 17 green + 16 exc_ + terminal (doc 13 §13.2)
  resumeState      String?
  totalAmount      Decimal  @db.Decimal(12, 2)
  currency         String   @default("LYD")
  channel          String   @default("app")
  details          Json     @default("{}")
  passengers       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([state])
  @@map("bookings")
}

model StatusHistory {
  id        String   @id @default(uuid())
  bookingId String
  fromState String
  toState   String
  actorType String
  actorId   String?
  note      String?
  createdAt DateTime @default(now())
  @@index([bookingId])
  @@map("status_history")
}

model Exceptions {
  id                       String   @id @default(uuid())
  type                     String   // 17-type taxonomy (doc 13 §13.3)
  severity                 String
  bookingId                String
  bookingReference         String
  customerName             String
  serviceType              String
  routedRole               String
  assignedTo               String?
  status                   String
  rootCause                String
  context                  Json     @default("{}")
  suggestedActions         Json     @default("[]")
  slaDueAt                 DateTime
  bookingStateAtCreation   String
  nextStateAfterResolution String?
  internalNotes            Json     @default("[]")
  resolutionAction         String?
  resolvedBy               String?
  resolvedAt               DateTime?
  createdAt                DateTime @default(now())
  @@index([status, routedRole, slaDueAt])
  @@map("exceptions")
}

model AutomationSettings {
  id               String   @id // workflowKey
  workflowKey      String   @unique
  level            String
  permanentA1      Boolean  @default(false)
  thresholds       Json
  params           Json     @default("{}")
  killSwitchActive Boolean  @default(false)
  killSwitchReason String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  @@map("automation_settings")
}

model AutomationDecisions {
  id              String   @id @default(uuid())
  workflowKey     String
  decision        String
  confidence      Float
  thresholdHigh   Float
  thresholdMedium Float
  level           String
  killSwitch      Boolean  @default(false)
  entityType      String?
  entityId        String?
  bookingId       String?
  createdAt       DateTime @default(now())
  @@index([workflowKey])
  @@map("automation_decisions")
}

model Payments {
  id         String   @id @default(uuid())
  bookingId  String
  reference  String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("LYD")
  payerName  String?
  method     String?
  receiptRef String?
  bankTxId   String?
  status     String
  confidence Float?
  decidedBy  String?
  createdAt  DateTime @default(now())
  @@index([bookingId])
  @@map("payments")
}

model PaymentReferences {
  id              String  @id // = reference (TRV-YYYY-NNNNNN)
  reference       String  @unique
  bookingId       String
  expectedAmount  Decimal @db.Decimal(12, 2)
  currency        String  @default("LYD")
  status          String
  amountReceived  Decimal? @db.Decimal(12, 2)
  difference      Decimal? @db.Decimal(12, 2)
  suggestedAction String?
  createdAt       DateTime @default(now())
  @@map("payment_references")
}

model CustomerConfirmations {
  id              String   @id @default(uuid())
  bookingId       String
  confirmedFields Json
  ip              String?
  userAgent       String?
  confirmedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  @@index([bookingId])
  @@map("customer_confirmations")
}

model AuditLogs {
  id            String   @id @default(uuid())
  actorType     String
  actorId       String?
  action        String
  bookingId     String?
  entityType    String?
  entityId      String?
  fromState     String?
  toState       String?
  confidence    Float?
  data          Json?
  result        String?
  error         String?
  staffOverride Boolean  @default(false)
  at            DateTime @default(now())
  createdAt     DateTime @default(now())
  @@index([bookingId])
  @@index([action])
  @@map("audit_logs")
}

model WalletItems {
  id            String   @id @default(uuid())
  bookingId     String
  itemType      String
  payload       Json     @default("{}")
  offlineCached Boolean  @default(true)
  createdAt     DateTime @default(now())
  @@index([bookingId])
  @@map("wallet_items")
}

model Messages {
  id           String   @id @default(uuid())
  bookingId    String
  channel      String
  template     String
  to           String?
  status       String
  attempt      Int      @default(1)
  error        String?
  providerMode String   @default("mock")
  createdAt    DateTime @default(now())
  @@index([bookingId])
  @@map("messages")
}

model Artifacts {
  id           String   @id @default(uuid())
  bookingId    String
  kind         String
  locale       String?
  fileRef      String?
  data         Json?
  providerMode String   @default("mock")
  createdAt    DateTime @default(now())
  @@index([bookingId])
  @@map("artifacts")
}

model VisaApplications {
  id             String   @id @default(uuid())
  bookingId      String
  country        String
  visaType       String
  checklist      Json
  readinessScore Int      @default(0)
  fileStatus     String
  appointmentAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([bookingId])
  @@map("visa_applications")
}

model Quotations {
  id        String   @id @default(uuid())
  bookingId String
  bodyAr    String
  bodyEn    String
  total     Decimal  @db.Decimal(12, 2)
  currency  String   @default("LYD")
  status    String
  decision  String?
  createdAt DateTime @default(now())
  @@map("quotations")
}

model KpiSnapshots {
  id        String   @id @default(uuid())
  period    String
  metrics   Json
  createdAt DateTime @default(now())
  @@map("kpi_snapshots")
}
