# ── Rihlati Smart Core — environment configuration ─────────────────────────
# Copy to .env and adjust. EVERY integration falls back to MOCK MODE when its
# key is empty, so the whole smart core runs with no external accounts.
# Full explanation: docs/14-activation-and-run-guide.md §B

# Core
API_PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Persistence: leave DATABASE_URL empty for zero-setup in-memory MOCK mode.
# Set it (and PERSISTENCE=postgres) to use PostgreSQL 15+ via Prisma.
DATABASE_URL=
# PERSISTENCE=postgres

# WhatsApp Business Cloud API (empty = mock provider)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OCR provider (empty = mock passport OCR)
OCR_PROVIDER_API_KEY=

# Payments gateway (empty = mock; bank-transfer matching works regardless)
PAYMENT_PROVIDER_KEY=

# Email provider (empty = mock)
EMAIL_PROVIDER_KEY=

# AI provider — Claude API key (empty = mock planner/quotations/pre-check)
AI_PROVIDER_API_KEY=

# Supplier APIs (empty = mock FLIGHT-A / FLIGHT-B / HOTEL-A adapters)
FLIGHT_SUPPLIER_KEY=
HOTEL_SUPPLIER_KEY=

# PDF output
PDF_STORAGE_PATH=./storage/pdfs

# Automation governance (boot defaults; runtime control via admin dashboard)
DEFAULT_AUTOMATION_LEVEL=
ENABLE_WHATSAPP_AUTOMATION=true
ENABLE_PAYMENT_MATCHING=true
ENABLE_OCR=true
ENABLE_PDF_GENERATION=true
